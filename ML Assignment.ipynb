# 1. Import libraries
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler
from sklearn.linear_model import LogisticRegression, Ridge
from sklearn.metrics import log_loss, accuracy_score

# 2. Load the dataset
url = "https://archive.ics.uci.edu/ml/machine-learning-databases/breast-cancer-wisconsin/wdbc.data"
columns = ['ID', 'Diagnosis'] + [f'f{i}' for i in range(1, 31)]
data = pd.read_csv(url, header=None, names=columns)
X = data.iloc[:, 2:].values
y = (data.Diagnosis == 'M').astype(int).values  # Malignant=1, Benign=0

# 3. Split data (70% train/val, 30% test)
X_train, X_test, y_train, y_test = train_test_split(
    X, y, stratify=y, test_size=0.3, random_state=42)

# 4. Standardize features
scaler = StandardScaler()
X_train_std = scaler.fit_transform(X_train)
X_test_std = scaler.transform(X_test)

# 5. Objective of logistic regression with L2 regularization
print("Objective: min_w { (1/N) * sum_i log(1+exp(-y_i w^T x_i)) + λ * ||w||^2 }")

# 6. Logistic Regression with L2 regularization and λ values
lambdas = [0, 0.1, 1, 10, 100, 1000]
train_losses, test_losses, w_norms, acc_trains, acc_tests = [], [], [], [], []
weights_all = []

for lam in lambdas:
    clf = LogisticRegression(penalty='l2', C=1.0/(lam+1e-8), solver='lbfgs', max_iter=1000)
    clf.fit(X_train_std, y_train)
    y_train_pred = clf.predict_proba(X_train_std)
    y_test_pred = clf.predict_proba(X_test_std)
    train_losses.append(log_loss(y_train, y_train_pred))
    test_losses.append(log_loss(y_test, y_test_pred))
    w = clf.coef_.flatten()
    w_norms.append(np.linalg.norm(w))
    acc_trains.append(accuracy_score(y_train, clf.predict(X_train_std)))
    acc_tests.append(accuracy_score(y_test, clf.predict(X_test_std)))
    weights_all.append(w)

# 7. Plot Cross-Entropy Error
plt.figure(figsize=(8,5))
plt.plot(lambdas, train_losses, marker='o', label='Train')
plt.plot(lambdas, test_losses, marker='s', label='Test')
plt.xscale('log')
plt.xlabel('λ (log scale)')
plt.ylabel('Cross-Entropy Loss')
plt.legend(); plt.title('Cross-Entropy vs λ')
plt.show()

# 8. Plot L2 norm of weight vector vs λ
plt.figure(figsize=(8,5))
plt.plot(lambdas, w_norms, marker='o')
plt.xscale('log')
plt.xlabel('λ')
plt.ylabel('L2 Norm of Weights')
plt.title('L2 Norm vs λ')
plt.show()

# 9. Plot weight values vs λ
plt.figure(figsize=(10,6))
weights_all_arr = np.array(weights_all)
for i in range(weights_all_arr.shape[1]):
    plt.plot(lambdas, weights_all_arr[:, i])
plt.xscale('log')
plt.xlabel('λ')
plt.ylabel('Weights')
plt.title('Weight Values vs λ')
plt.show()

# 10. Plot accuracy for train and test vs λ
plt.figure(figsize=(8,5))
plt.plot(lambdas, acc_trains, marker='o', label='Train Accuracy')
plt.plot(lambdas, acc_tests, marker='s', label='Test Accuracy')
plt.xscale('log')
plt.xlabel('λ')
plt.ylabel('Accuracy')
plt.legend(); plt.title('Accuracy vs λ')
plt.show()

# 11. Gaussian Basis Functions construction
def gaussian_basis(x, mu, sigma):
    return np.exp(-((x - mu) ** 2) / (2 * sigma ** 2))

sigmas = [0.1, 0.5, 1, 5, 10]
means = np.linspace(-10, 10, 5)  # 5 means from -10 to 10 for each feature

train_errors, test_errors = [], []
constant_train = min(train_losses)
constant_test = min(test_losses)

for sigma in sigmas:
    # Stack all basis-transformed features together
    X_train_phi = np.hstack([gaussian_basis(X_train_std, mu, sigma) for mu in means])
    X_test_phi = np.hstack([gaussian_basis(X_test_std, mu, sigma) for mu in means])
    clf = LogisticRegression(penalty='none', solver='lbfgs', max_iter=1000)
    clf.fit(X_train_phi, y_train)
    train_errors.append(log_loss(y_train, clf.predict_proba(X_train_phi)))
    test_errors.append(log_loss(y_test, clf.predict_proba(X_test_phi)))

# 12. Plot errors vs sigma
plt.figure(figsize=(8,5))
plt.plot(sigmas, train_errors, marker='o', label='Train Error')
plt.plot(sigmas, test_errors, marker='s', label='Test Error')
plt.hlines(constant_train, sigmas[0], sigmas[-1], colors='blue', linestyles='dashed', label='Const Train Loss')
plt.hlines(constant_test, sigmas[0], sigmas[-1], colors='red', linestyles='dashed', label='Const Test Loss')
plt.xlabel('Sigma')
plt.ylabel('Log Loss')
plt.title('Train/Test Error vs Sigma')
plt.legend()
plt.show()

# 13. Linear Regression experiment on complex data
from sklearn.datasets import load_boston
boston = load_boston()
X_b, y_b = boston.data, boston.target
Xb_train, Xb_test, yb_train, yb_test = train_test_split(
    X_b, y_b, random_state=42, test_size=0.2)
scaler_b = StandardScaler()
Xb_train_std = scaler_b.fit_transform(Xb_train)
Xb_test_std = scaler_b.transform(Xb_test)
ridge = Ridge(alpha=1.0)
ridge.fit(Xb_train_std, yb_train)
print("Linear regression test RMSE:", np.sqrt(np.mean((ridge.predict(Xb_test_std) - yb_test)**2)))
